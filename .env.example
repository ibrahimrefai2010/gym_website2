# ─────────────────────────────────────────────────────────────────────────────
# Muscle and Fitness Center — environment template
# Copy to `.env` and fill in. Never commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
BASE_URL=https://yourdomain.com
# Single origin, or a comma-separated list if the Women's branch subdomain
# needs to be allowed too (subdomain branch routing -- see branchResolver.js):
# CORS_ORIGIN=https://yourdomain.com,https://women.yourdomain.com
CORS_ORIGIN=https://yourdomain.com
# DEMO_MODE=false

# ── Database (MySQL/MariaDB) ────────────────────────────────────────────────
# Either DATABASE_URL, or the discrete DB_* values below.
# DATABASE_URL=mysql://user:pass@host:3306/muscle_fitness
DB_HOST=localhost
DB_PORT=3306
DB_NAME=muscle_fitness
DB_USER=
DB_PASSWORD=

# ── Auth / crypto ──────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BCRYPT_ROUNDS=12
# Admin session idle timeout, enforced at refresh-token rotation. Minutes.
ADMIN_IDLE_TIMEOUT_MINUTES=480

# ── Seed admin (used by `npm run admin:ensure`) ────────────────────────────
ADMIN_EMAIL=admin@localhost.test
ADMIN_FULL_NAME=System Administrator
# If omitted, a strong password is generated and printed once.
ADMIN_PASSWORD=
# Required in production. Guards POST /api/v1/admin/users (x-admin-secret header).
ADMIN_REGISTRATION_SECRET=

# ── Email (SMTP) ───────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Muscle and Fitness Center <noreply@yourdomain.com>"
OTP_EXPIRY_MINUTES=15

# ── Rate limits ────────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_OTP=3

# ── AI assistant (admin dashboard) ─────────────────────────────────────────
# Off unless AI_ASSISTANT_ENABLED=true. With it on but no ANTHROPIC_API_KEY,
# a basic rule-based answer is used. The assistant is read-only: it can look
# up branch-scoped figures and draft text, never change data.
AI_ASSISTANT_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (low suits quick dashboard Q&A)
AI_EFFORT=low
# Questions per admin per hour.
AI_RATE_LIMIT_PER_HOUR=30

# ── Payments — Moyasar (Mada / Visa / Mastercard / Apple Pay) ──────────────
# The only online payment provider. `test` uses Moyasar test keys; switch to
# `live` at deployment with production keys.
MOYASAR_MODE=test
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
# Must equal the "secret token" set on the webhook in the Moyasar dashboard
# (Settings -> Webhooks). Webhook URL: https://yourdomain.com/api/v1/payments/webhook/moyasar
# Subscribe to at least: payment_paid, payment_failed.
MOYASAR_WEBHOOK_SECRET=
# Minutes a hosted-checkout invoice stays payable (default 60).
MOYASAR_INVOICE_TTL_MINUTES=60
# Moyasar redirects the member back to <the branch's own origin>/user.html?payment=<id>.
# The origin is taken from CORS_ORIGIN (so each branch subdomain returns to itself);
# PAYMENT_SUCCESS_URL / PAYMENT_CANCEL_URL below are only used by the retired Stripe adapter.
PAYMENT_SUCCESS_URL=https://yourdomain.com/user.html?payment=success
PAYMENT_CANCEL_URL=https://yourdomain.com/user.html?payment=cancelled

# ── Payments — Stripe (RETIRED) ───────────────────────────────────────────
# Stripe was retired in favour of Moyasar. The adapter code remains but is not
# offered in the UI. Leave these blank unless deliberately re-enabling Stripe.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ── ZATCA (Phase 1 simplified tax invoice) ────────────────────────────────
# Seller identity lives in the `business_settings` table (Admin → Settings →
# Business Info), not here. Nothing to configure via env.

# ── Analytics / marketing tags (loaded only when set) ─────────────────────
GA4_MEASUREMENT_ID=
META_PIXEL_ID=

# ── Automated database backup ────────────────────────────────────────────
# Real mysqldump-based backups to storage/backups/. Leave BACKUP_CRON empty to
# disable the schedule (manual trigger via Admin → Backups still works).
BACKUP_CRON=0 3 * * *
BACKUP_RETENTION_DAYS=14
# Optional explicit path to the mysqldump binary if not on PATH.
MYSQLDUMP_PATH=
