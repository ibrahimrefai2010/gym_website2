# Self-contained demo image: MariaDB + Node in one container.
# Migrations + seed + demo content run on every boot. Data is NOT persistent
# (fine for a throwaway demo). For real deployment use ./Dockerfile with an
# external managed database instead.
FROM node:20-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
       mariadb-server mariadb-client ca-certificates procps \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package*.json ./
RUN npm ci --omit=dev

COPY . .

ENV NODE_ENV=production \
    PORT=3000 \
    DB_HOST=127.0.0.1 \
    DB_PORT=3306 \
    DB_USER=root \
    DB_PASSWORD=demo \
    DB_NAME=muscle_fitness \
    DEMO_MODE=true

COPY docker/demo-entrypoint.sh /usr/local/bin/demo-entrypoint.sh
RUN chmod +x /usr/local/bin/demo-entrypoint.sh

EXPOSE 3000
CMD ["/usr/local/bin/demo-entrypoint.sh"]
